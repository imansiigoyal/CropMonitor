# ── Node ─────────────────────────────────────
node_modules/
npm-debug.log*

# ── Environment (NEVER commit secrets) ───────
backend/.env

# ── SQLite database (ephemeral on Render) ────
backend/cropmonitor.db
backend/cropmonitor.db-journal

# ── Uploaded images ──────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── OS files ─────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────
.vscode/
*.log

# ── Streamlit secrets (NEVER commit) ─────────────
streamlit_app/.streamlit/secrets.toml

# ── Python artifacts ──────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
streamlit_app/cropmonitor.db
