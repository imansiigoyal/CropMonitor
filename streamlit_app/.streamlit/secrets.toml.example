# .streamlit/secrets.toml — Streamlit Cloud secrets
# Copy this file to secrets.toml and fill in your values.
# On Streamlit Cloud, paste these in Settings → Secrets (do NOT commit the real file).

# Google Gemini API Key — get yours free at https://aistudio.google.com
GEMINI_API_KEY = "your_gemini_api_key_here"

# Irrigation thresholds (optional — defaults are 30/60)
# MOISTURE_ON_THRESHOLD  = "30"
# MOISTURE_OFF_THRESHOLD = "60"
